<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes">
  <ResourceDictionary.MergedDictionaries>
    <md:BundledTheme BaseTheme="Dark" PrimaryColor="Blue" SecondaryColor="LightGreen" />
    <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign2.Defaults.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <SolidColorBrush x:Key="AppBackground" Color="#121417"/><SolidColorBrush x:Key="AppSurface" Color="#1B1E23"/>
  <SolidColorBrush x:Key="AppField" Color="#171A1F"/><SolidColorBrush x:Key="AppRaised" Color="#23272E"/>
  <SolidColorBrush x:Key="AppBorder" Color="#353B45"/><SolidColorBrush x:Key="AppText" Color="#E4E8EF"/>
  <SolidColorBrush x:Key="AppMuted" Color="#A5AFBD"/><SolidColorBrush x:Key="AppPrimary" Color="#ADC6FF"/>
  <SolidColorBrush x:Key="AppOnPrimary" Color="#102E60"/><SolidColorBrush x:Key="AppSuccess" Color="#9FD8B1"/>
  <SolidColorBrush x:Key="AppWarning" Color="#EBC27D"/><SolidColorBrush x:Key="AppNotice" Color="#352E22"/>
  <SolidColorBrush x:Key="AppError" Color="#FFB4AB"/><SolidColorBrush x:Key="AppSelection" Color="#263A58"/>
  <SolidColorBrush x:Key="MatchBackground" Color="#465738"/><SolidColorBrush x:Key="MatchForeground" Color="#E4F2B6"/>
  <BooleanToVisibilityConverter x:Key="VisibleWhen"/>
  <Style x:Key="ProductWindow" TargetType="Window" BasedOn="{StaticResource MaterialDesignWindow}">
    <Setter Property="Background" Value="{StaticResource AppBackground}"/><Setter Property="Foreground" Value="{StaticResource AppText}"/>
    <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI"/><Setter Property="FontSize" Value="13"/>
    <Setter Property="UseLayoutRounding" Value="True"/><Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
  </Style>
  <Style x:Key="CompactButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
    <Setter Property="Height" Value="34"/><Setter Property="MinWidth" Value="0"/><Setter Property="Padding" Value="12,0"/>
    <Setter Property="Foreground" Value="{StaticResource AppText}"/><Setter Property="BorderBrush" Value="{StaticResource AppBorder}"/>
    <Setter Property="md:RippleAssist.IsDisabled" Value="True"/>
  </Style>
  <Style TargetType="Button" BasedOn="{StaticResource CompactButton}"/>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
    <Setter Property="Height" Value="40"/><Setter Property="Padding" Value="22,0"/><Setter Property="Foreground" Value="{StaticResource AppOnPrimary}"/>
    <Setter Property="Background" Value="{StaticResource AppPrimary}"/><Setter Property="BorderBrush" Value="{StaticResource AppPrimary}"/>
    <Setter Property="md:RippleAssist.IsDisabled" Value="True"/>
  </Style>
  <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
    <Setter Property="Height" Value="28"/><Setter Property="MinWidth" Value="0"/><Setter Property="Padding" Value="6,0"/>
    <Setter Property="Foreground" Value="{StaticResource AppMuted}"/><Setter Property="md:RippleAssist.IsDisabled" Value="True"/>
  </Style>
  <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
    <Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="10,5"/><Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Foreground" Value="{StaticResource AppText}"/><Setter Property="Background" Value="{StaticResource AppField}"/>
    <Setter Property="BorderBrush" Value="{StaticResource AppBorder}"/><Setter Property="FontSize" Value="13"/>
  </Style>
  <Style TargetType="CheckBox" BasedOn="{StaticResource MaterialDesignCheckBox}">
    <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Foreground" Value="{StaticResource AppText}"/>
    <Setter Property="md:RippleAssist.IsDisabled" Value="True"/>
  </Style>
  <Style x:Key="MutedText" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource AppMuted}"/><Setter Property="FontSize" Value="12"/></Style>
  <Style TargetType="DataGrid" BasedOn="{StaticResource MaterialDesignDataGrid}">
    <Setter Property="Background" Value="{StaticResource AppField}"/><Setter Property="Foreground" Value="{StaticResource AppText}"/>
    <Setter Property="BorderBrush" Value="{StaticResource AppBorder}"/><Setter Property="BorderThickness" Value="1"/>
    <Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="{StaticResource AppRaised}"/>
    <Setter Property="RowBackground" Value="{StaticResource AppField}"/><Setter Property="AlternatingRowBackground" Value="{StaticResource AppField}"/>
    <Setter Property="ColumnHeaderHeight" Value="32"/><Setter Property="RowHeight" Value="29"/>
    <Setter Property="md:DataGridAssist.CellPadding" Value="10,0"/>
  </Style>
  <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
    <Setter Property="Background" Value="{StaticResource AppRaised}"/><Setter Property="Foreground" Value="{StaticResource AppMuted}"/>
    <Setter Property="Padding" Value="10,0"/><Setter Property="FontSize" Value="12"/>
  </Style>
  <Style TargetType="DataGridCell" BasedOn="{StaticResource MaterialDesignDataGridCell}">
    <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="BorderThickness" Value="0"/>
    <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource AppSelection}"/><Setter Property="Foreground" Value="{StaticResource AppText}"/></Trigger></Style.Triggers>
  </Style>
</ResourceDictionary>
