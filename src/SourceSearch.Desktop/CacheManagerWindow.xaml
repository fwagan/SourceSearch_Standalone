<Window x:Class="SourceSearch.Desktop.CacheManagerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="索引缓存" Width="960" Height="540" MinWidth="720" MinHeight="400" Style="{StaticResource ProductWindow}" WindowStartupLocation="CenterOwner" Loaded="Window_Loaded" Closed="Window_Closed">
  <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="按仓库、目录和分支保存。使用中的缓存需要先切换目录或关闭其他窗口后再删除。" TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,0,0,12"/>
    <DataGrid x:Name="EntriesGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionUnit="FullRow" EnableRowVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling" HeadersVisibility="Column">
      <DataGrid.Columns>
        <DataGridTextColumn Header="文件夹" Binding="{Binding SourceRoot}" Width="3*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding SourceRoot}"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
        <DataGridTextColumn Header="分支" Binding="{Binding Branch}" Width="*"/>
        <DataGridTextColumn Header="最后建立(UTC)" Binding="{Binding CreatedUtc, StringFormat=yyyy-MM-dd HH:mm}" Width="145"/>
        <DataGridTextColumn Header="当前索引字节" Binding="{Binding Bytes, StringFormat=N0}" Width="110"/>
        <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="2*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding Status}"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
      </DataGrid.Columns>
    </DataGrid>
    <Grid Grid.Row="2" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="StatusText" TextWrapping="Wrap" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,12,0"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="RefreshButton" Content="刷新" Click="Refresh_Click" Margin="0,0,8,0"/><Button x:Name="DeleteButton" Content="删除所选" Click="Delete_Click" Margin="0,0,8,0"/><Button Content="关闭" Click="Close_Click" IsCancel="True"/></StackPanel>
    </Grid>
  </Grid>
</Window>
