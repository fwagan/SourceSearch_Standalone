<Window x:Class="SourceSearch.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes" xmlns:controls="clr-namespace:SourceSearch.Desktop.Controls"
        Title="Source Search" Width="1180" Height="780" MinWidth="880" MinHeight="600" Style="{StaticResource ProductWindow}"
        Closing="Window_Closing" Activated="Window_Activated" SizeChanged="Window_SizeChanged">
  <Window.CommandBindings><CommandBinding Command="ApplicationCommands.Find" Executed="FocusSearch_Executed"/></Window.CommandBindings>
  <Window.InputBindings><KeyBinding Key="F" Modifiers="Control" Command="ApplicationCommands.Find"/></Window.InputBindings>
  <Grid x:Name="LayoutRoot" SizeChanged="Window_SizeChanged">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="{StaticResource AppSurface}" BorderBrush="{StaticResource AppBorder}" BorderThickness="0,0,0,1" Padding="18,14,18,10">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,16,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding FolderName}" ToolTip="{Binding FolderName}" TextTrimming="CharacterEllipsis" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="1" Text="{Binding BranchLabel}" MaxWidth="160" TextTrimming="CharacterEllipsis" Style="{StaticResource MutedText}" Margin="14,3,0,0"><TextBlock.ToolTip><StackPanel><TextBlock Text="{Binding BranchLabel}"/><TextBlock Text="{Binding Identity.Error}"/></StackPanel></TextBlock.ToolTip></TextBlock></Grid>
            <TextBlock Text="{Binding RootPath}" ToolTip="{Binding RootPath}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" Margin="0,5,0,0" AutomationProperties.AutomationId="RootPath"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="0,0,14,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource AppSuccess}"/><Style.Triggers><DataTrigger Binding="{Binding IsWarning}" Value="True"><Setter Property="Foreground" Value="{StaticResource AppWarning}"/></DataTrigger><DataTrigger Binding="{Binding IsBuilding}" Value="True"><Setter Property="Foreground" Value="{StaticResource AppPrimary}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
            <Button x:Name="ChooseFolderButton" Content="选择文件夹" Click="ChooseFolder_Click" IsEnabled="{Binding CanEdit}" Margin="0,0,8,0"/>
            <Button Content="{Binding BuildLabel}" Command="{Binding BuildCommand}" Visibility="{Binding ShowBuildButton, Converter={StaticResource VisibleWhen}}"/>
            <Button Content="取消建立" Command="{Binding CancelCommand}" Visibility="{Binding IsBuilding, Converter={StaticResource VisibleWhen}}"/>
          </StackPanel>
        </Grid>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0"><TextBlock Text="{Binding IndexSummary}" Style="{StaticResource MutedText}" VerticalAlignment="Center"/><Button x:Name="DetailsButton" Content="详情" Click="Details_Click" Style="{StaticResource QuietButton}" Margin="8,0,0,0" Visibility="{Binding HasDetails, Converter={StaticResource VisibleWhen}}"/></StackPanel>
        <ProgressBar Grid.Row="2" Height="3" Margin="0,6,0,0" IsIndeterminate="True" Visibility="{Binding IsBuilding, Converter={StaticResource VisibleWhen}}"/>
      </Grid>
    </Border>
    <Grid Grid.Row="1" Margin="18,16,18,12">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Grid Margin="0,0,10,0"><TextBox x:Name="QueryInput" AutomationProperties.AutomationId="QueryText" Text="{Binding QueryText, UpdateSourceTrigger=PropertyChanged}" Height="40" FontSize="16" Padding="34,4,10,4" md:HintAssist.Hint="搜索代码、标识符或文本" md:HintAssist.IsFloating="False">
          <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding SearchCommand}"/></TextBox.InputBindings>
        </TextBox><md:PackIcon Kind="Magnify" Width="18" Height="18" Margin="11,0,0,0" Foreground="{StaticResource AppMuted}" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"/></Grid>
        <Button x:Name="SearchButton" Grid.Column="1" Content="搜索" Command="{Binding SearchCommand}" Style="{StaticResource PrimaryButton}"/>
        <CheckBox Grid.Column="2" Content="全字匹配" IsChecked="{Binding WholeWord}" Margin="14,0,0,0" ToolTip="仅匹配完整单词，如 User；不匹配 GetUser"/>
      </Grid>
      <Grid x:Name="FiltersGrid" Grid.Row="1" Margin="0,12,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid x:Name="IncludeFilter" Margin="0,0,8,0"><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <CheckBox Content="仅包含文件类型" IsChecked="{Binding IncludeEnabled}"/>
          <TextBox x:Name="IncludeInput" Grid.Column="1" Text="{Binding IncludeText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IncludeEnabled}" ToolTip="例如 cs,js,json；逗号分隔"/>
        </Grid>
        <Grid x:Name="ExcludeFilter" Grid.Column="1" Margin="8,0,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <CheckBox Content="排除文件类型" IsChecked="{Binding ExcludeEnabled}"/>
          <TextBox x:Name="ExcludeInput" Grid.Column="1" Text="{Binding ExcludeText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding ExcludeEnabled}" ToolTip="例如 json,map；排除优先"/>
        </Grid>
      </Grid>
      <TextBlock Grid.Row="2" Text="{Binding QueryHint}" TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,9,0,0"/>
    </Grid>
    <Border Grid.Row="2" Background="{StaticResource AppNotice}" BorderBrush="{StaticResource AppWarning}" BorderThickness="3,0,0,0" Padding="10,8" Margin="18,0,18,12" Visibility="{Binding HasNotice, Converter={StaticResource VisibleWhen}}">
      <TextBlock Text="{Binding NoticeText}" Foreground="{StaticResource AppWarning}" TextWrapping="Wrap"/>
    </Border>
    <Grid Grid.Row="3" Margin="18,0,18,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border BorderBrush="{StaticResource AppBorder}" BorderThickness="0,1,0,0" Padding="0,9,0,9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="搜索结果"/><TextBlock Grid.Column="1" Text="{Binding AppliedLabel}" ToolTip="{Binding AppliedDescription}" TextTrimming="CharacterEllipsis" Style="{StaticResource MutedText}" Margin="12,1,12,0"/>
        <TextBlock Grid.Column="2" Text="{Binding ResultCountText}" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
        <Button Grid.Column="3" Content="取消搜索" Command="{Binding CancelCommand}" Style="{StaticResource QuietButton}" Margin="8,-5,0,-5" Visibility="{Binding ShowQueryCancel, Converter={StaticResource VisibleWhen}}"/>
      </Grid></Border>
      <DataGrid x:Name="ResultsGrid" Grid.Row="1" ItemsSource="{Binding Results}" IsReadOnly="True" AutoGenerateColumns="False" EnableRowVirtualization="True" EnableColumnVirtualization="True"
                VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" CanUserSortColumns="False" CanUserAddRows="False" CanUserReorderColumns="False" HeadersVisibility="Column" SelectionMode="Single" SelectionUnit="FullRow">
        <DataGrid.ContextMenu><ContextMenu><MenuItem Header="复制完整路径" Click="CopyPath_Click"/></ContextMenu></DataGrid.ContextMenu>
        <DataGrid.Columns>
          <DataGridTextColumn Header="文件全路径" Binding="{Binding FilePath}" Width="42*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding FilePath}"/><Setter Property="Foreground" Value="{StaticResource AppMuted}"/><Setter Property="FontSize" Value="12"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
          <DataGridTemplateColumn Header="匹配行" Width="58*" ClipboardContentBinding="{Binding DisplayLine}"><DataGridTemplateColumn.CellTemplate><DataTemplate>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock Text="{Binding LineNumber}" Foreground="{StaticResource AppMuted}" FontFamily="Consolas" FontSize="12" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
              <controls:HighlightedLine Grid.Column="1" Row="{Binding}" FontFamily="Consolas" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </Grid>
          </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
      <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="600" Margin="24" IsHitTestVisible="False" Visibility="{Binding ShowEmpty, Converter={StaticResource VisibleWhen}}">
        <TextBlock Text="{Binding EmptyTitle}" FontSize="18" TextAlignment="Center"/><TextBlock Text="{Binding EmptyDescription}" Style="{StaticResource MutedText}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0"/>
      </StackPanel>
    </Grid>
    <Grid Grid.Row="4" Margin="18,10,18,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="{Binding TimingText}" TextWrapping="Wrap" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,12,0"/>
      <Button Grid.Column="1" Content="加载下 100 条" Command="{Binding MoreCommand}"/>
    </Grid>
  </Grid>
</Window>
