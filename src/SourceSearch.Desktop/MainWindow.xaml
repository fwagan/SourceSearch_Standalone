<Window x:Class="SourceSearch.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Source Search · 核心验证" Width="1120" Height="760" MinWidth="720" MinHeight="500" Closing="Window_Closing">
  <Grid Margin="16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel Grid.Row="0">
      <TextBlock Text="索引目录" Margin="0,0,0,4"/>
      <TextBox AutomationProperties.AutomationId="RootPath" Text="{Binding RootPath, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" Padding="6"/>
      <StackPanel Orientation="Horizontal" Margin="0,8">
        <Button Content="选择目录" Click="ChooseFolder_Click" IsEnabled="{Binding CanEdit}" Padding="10,5" Margin="0,0,8,0"/>
        <Button Content="建立 / 重建索引" Click="Build_Click" IsEnabled="{Binding CanEdit}" Padding="10,5" Margin="0,0,8,0"/>
        <Button Content="取消" Click="Cancel_Click" Padding="10,5"/>
      </StackPanel>
      <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap"/>
    </StackPanel>
    <StackPanel Grid.Row="1" Margin="0,16,0,12">
      <TextBlock Text="搜索文本" Margin="0,0,0,4"/>
      <TextBox AutomationProperties.AutomationId="QueryText" Text="{Binding QueryText, UpdateSourceTrigger=PropertyChanged}" KeyDown="Query_KeyDown" Padding="6"/>
      <CheckBox Content="全字匹配" IsChecked="{Binding WholeWord}" Margin="0,8"/>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <CheckBox Content="仅包含文件类型" IsChecked="{Binding IncludeEnabled}" VerticalAlignment="Center"/>
        <TextBox Grid.Column="1" Text="{Binding IncludeText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IncludeEnabled}" Padding="4" ToolTip="例如 cs,js,json"/>
        <CheckBox Grid.Row="1" Content="排除文件类型" IsChecked="{Binding ExcludeEnabled}" VerticalAlignment="Center" Margin="0,6,0,0"/>
        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ExcludeText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding ExcludeEnabled}" Padding="4" Margin="0,6,0,0" ToolTip="例如 min,map；多个后缀以逗号分隔"/>
      </Grid>
      <StackPanel Orientation="Horizontal" Margin="0,8">
        <Button Content="搜索" Click="Search_Click" IsEnabled="{Binding CanSearch}" Padding="16,5" Margin="0,0,8,0"/>
        <Button Content="加载下一批" Click="More_Click" IsEnabled="{Binding CanMore}" Padding="10,5"/>
      </StackPanel>
      <TextBlock Text="{Binding TimingText}" TextWrapping="Wrap"/>
    </StackPanel>
    <DataGrid x:Name="ResultsGrid" Grid.Row="2" ItemsSource="{Binding Results}" IsReadOnly="True" AutoGenerateColumns="False"
              EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling"
              CanUserSortColumns="False" CanUserAddRows="False" RowHeight="25" HeadersVisibility="Column" SelectionMode="Single">
      <DataGrid.Columns>
        <DataGridTextColumn Header="文件全路径" Binding="{Binding FilePath}" Width="2*"/>
        <DataGridTextColumn Header="匹配行" Binding="{Binding DisplayLine}" Width="3*"/>
      </DataGrid.Columns>
    </DataGrid>
  </Grid>
</Window>
